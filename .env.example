# Copy to .env and fill in. Values here are examples; a commented-out line shows the default.
# With APP_ENV=prod the app refuses to start with unsafe settings and lists what to fix
# (see the production block at the end of this file).

# ---------------------------------------------------------------- core
APP_ENV=dev                       # dev | prod
APP_NAME=Flow                     # the broker name shown everywhere (also: Administration > Branding)
PUBLIC_URL=http://127.0.0.1:8000  # prod: https://portal.yourbroker.com (used in emails / referral links)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Encrypts the MT5 manager password and staff/client 2FA secrets stored in the database (defaults to
# SECRET_KEY; required in prod). Generate like SECRET_KEY and back it up with the database. On an install
# that ran without it, set it to the current SECRET_KEY value, or stored secrets can no longer be read.
CREDENTIALS_KEY=
# PostgreSQL only. setup.ps1 creates one in Docker and fills these in; or point DATABASE_URL at your own server.
DATABASE_URL=postgresql+psycopg://crm:STRONG_PASSWORD@127.0.0.1:5432/crm
# The Docker database (docker-compose.yml); setup.ps1 generates the password and picks a free port
# POSTGRES_USER=flow
# POSTGRES_PASSWORD=
# POSTGRES_DB=flow
# POSTGRES_PORT=5432
# Host names this server answers to, comma separated ("*" = any; prod: portal.yourbroker.com,backoffice.yourbroker.com)
ALLOWED_HOSTS=*
# prod: the two host names Caddy (the HTTPS proxy service) serves; setup.ps1 -PortalHost / -BackofficeHost
# PORTAL_HOST=portal.yourbroker.com
# BACKOFFICE_HOST=backoffice.yourbroker.com

# Apply migrations at startup (dev convenience). In prod set false and run `python -m app.cli migrate` on deploy.
AUTO_MIGRATE=true

# ---------------------------------------------------------------- MT5
# The CRM works with one MT5 server, set up in the admin under MT5 -> Configuration (address, manager
# login and password are stored there, encrypted). MT5_SERVER / MT5_MANAGER_* below are read only once,
# when upgrading an older install: they become that server.
MT5_GATEWAY=mock                  # mock (simulator) | manager (real server; required in prod)
MT5_SERVER=mt5.yourbroker.com:443
MT5_MANAGER_LOGIN=1000
MT5_MANAGER_PASSWORD=
# MT5_TIMEOUT_MS=30000            # Manager API call timeout
MT5_WORK_DIR=./mt5data            # Manager API cache, one sub-folder per process
# Simulator only: file that keeps the simulated MT5 state across restarts (empty = memory only; must be empty in prod)
# MOCK_STATE_FILE=
# Runs the sync/copy worker inside the web process. Leave unset: on while the server is a
# simulator, off otherwise (then run the separate worker service). Must not be true in prod.
# EMBEDDED_WORKER=false
# Custom modules in custom/ (docs/custom/README.md). false runs Flow without them, to tell whose problem something is
# CUSTOM_ENABLED=true
SYNC_INTERVAL_SECONDS=10
# Accounts with no open trade and no deal for SYNC_ACTIVE_MINUTES are polled only every
# SYNC_IDLE_INTERVAL_SECONDS (a pushed deal makes them active again)
SYNC_IDLE_INTERVAL_SECONDS=300
SYNC_ACTIVE_MINUTES=30
# Deals are re-read this many seconds back from the last one seen (catches late-arriving deals)
# SYNC_OVERLAP_SECONDS=120
# Last terminal connection of every account, from the Manager API's local copy (minutes, 0 = off)
ACTIVITY_REFRESH_MINUTES=5
# MT5 > Server health: read the server's load every N minutes (0 = only with "Read now"), keep N days
HEALTH_INTERVAL_MINUTES=5
HEALTH_KEEP_DAYS=7
# Syncs started in the back-office run in the background, this many at once (MT5 > Import from MT5 > History)
SYNC_THREADS=4
# Import MT5 groups -> account groups and users -> trading accounts (minutes, 0 = only via the buttons)
MT5_IMPORT_INTERVAL_MINUTES=15
MT5_SYNC_EXCLUDE_GROUPS=managers\*,manager\*,preliminary*,coverage*

# ---------------------------------------------------------------- security
STAFF_2FA_REQUIRED=false          # prod: true
# API tokens (minutes)
ACCESS_TOKEN_MINUTES=60           # staff
CLIENT_TOKEN_MINUTES=720          # clients
# Web sign-ins last at most SESSION_HOURS, and end after N minutes without a request
SESSION_HOURS=12
STAFF_SESSION_IDLE_MINUTES=60
CLIENT_SESSION_IDLE_MINUTES=120
# From MAX_FAILED_LOGINS failed logins on, each failure makes the account wait 1, 2, 4, ... minutes,
# at most LOCKOUT_MINUTES
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_MINUTES=30         # how long a password reset link works
AUTH_RATE_LIMIT_PER_MINUTE=20     # per IP: login / register / password reset requests
LIVE_REQUIRES_KYC=true

# ---------------------------------------------------------------- email (password resets, notifications)
# Leave SMTP_HOST empty to log that an email was sent (recipient and subject only) instead (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=no-reply@yourbroker.com

# ---------------------------------------------------------------- branding (website, client area, back-office, emails)
# Defaults for Administration > Branding, where they can be changed without a restart.
# BRAND_TAGLINE=Trade global markets with confidence
# COMPANY_LEGAL_NAME=Flow Ltd
# ACCENT_COLOR=#2563eb               # buttons, links and highlights
# REGULATORY_TEXT=Flow Ltd is authorised and regulated by ... (licence no. ...).
# SUPPORT_EMAIL=support@yourbroker.com
# SUPPORT_PHONE=
# MT5_SERVER_NAME=Flow-Live          # the server name clients pick in the MT5 terminal
MT5_DOWNLOAD_WINDOWS=https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe
MT5_DOWNLOAD_ANDROID=https://play.google.com/store/apps/details?id=net.metaquotes.metatrader5
MT5_DOWNLOAD_IOS=https://apps.apple.com/app/metatrader-5/id413251709
MT5_WEBTERMINAL_URL=https://web.metatrader.app/terminal
# Instruments shown in the public price widgets until MT5 > Symbols & pricing > Website prices is saved
PUBLIC_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,XAUUSD,XAGUSD,US30,NAS100,BTCUSD

# ---------------------------------------------------------------- business
BASE_CURRENCY=USD
DEPOSIT_INSTRUCTIONS=Transfer funds to IBAN XX00 0000 0000 0000 and use your client ID as the reference.
# Copy trading: don't mirror opens detected later than this; lot rounding for followers
COPY_MAX_OPEN_AGE_SECONDS=60
COPY_LOT_STEP=0.01
COPY_MIN_LOT=0.01

# ---------------------------------------------------------------- files & logs
STORAGE_DIR=./storage             # KYC documents - include in backups
LOG_DIR=./logs/crm                # empty = console only (Windows services set this)
LOG_LEVEL=INFO

# ---------------------------------------------------------------- production (APP_ENV=prod)
# The app refuses to start in prod unless all of these hold:
#   APP_ENV=prod
#   SECRET_KEY=<random, 32+ characters>
#   CREDENTIALS_KEY=<random, 32+ characters; back it up>
#   PUBLIC_URL=https://portal.yourbroker.com
#   ALLOWED_HOSTS=portal.yourbroker.com,backoffice.yourbroker.com
#   STAFF_2FA_REQUIRED=true
#   SMTP_HOST=smtp.yourbroker.com        (plus SMTP_USER / SMTP_PASSWORD / SMTP_FROM)
#   AUTO_MIGRATE=false                   (run `python -m app.cli migrate` on deploy)
#   MT5_GATEWAY=manager
#   EMBEDDED_WORKER unset or false       (run the worker service)
#   MOCK_STATE_FILE unset
# Check with: python -m app.cli check-config
